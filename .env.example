# Copy to .env for running the API/worker on the host (outside Docker) against
# the docker-compose services. Inside Docker, docker-compose.yml sets these.

DATABASE_URL=postgresql+asyncpg://files:files@localhost:5432/files
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=files

ADMIN_TOKEN=change-me

MAX_UPLOAD_BYTES=20971520
THUMBNAIL_SIZES=[128, 512]
SIGNED_URL_DEFAULT_TTL=300
SIGNED_URL_MAX_TTL=3600

# noop | clamav
SCANNER=noop
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
